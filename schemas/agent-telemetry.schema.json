{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent-dev-system/schemas/agent-telemetry.schema.json",
  "title": "Agent Telemetry Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repo", "task_id", "provider", "started_at"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "remote": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "worktree_path": { "type": ["string", "null"] }
      }
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": ["anthropic", "openai", "google", "local", "other"]
    },
    "tool": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "session_id": {
      "type": ["string", "null"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_miss_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "default": "USD" },
        "total_cost": { "type": ["number", "null"], "minimum": 0 },
        "review_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "merged_pr": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "merged_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "sanitized": { "type": "boolean" }
        }
      }
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 1000
    }
  }
}

