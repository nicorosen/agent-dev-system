{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent-dev-system/schemas/scaffold-values.schema.json",
  "title": "Scaffold Values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "REPO_NAME",
    "REPO_PURPOSE",
    "REPO_DOCS",
    "REPO_LAYOUT",
    "REPO_LOCAL_CONVENTIONS",
    "DEFAULT_COMMANDS",
    "HIGH_RISK_PATHS",
    "EXTERNAL_WRITE_OPERATIONS",
    "PRODUCTION_DATA_PATH_RULE",
    "CONFIG_CHANGE_RULE",
    "PERMISSION_BOUNDARY_RULE",
    "DEFAULT_READ_SCOPE",
    "EXCLUDED_PATHS",
    "BASELINE_COMMANDS",
    "SAFETY_TESTS",
    "SESSION_COMPACTION_RULE",
    "DOCTRINE_SOURCE",
    "SECURITY_DECISIONS_SOURCE",
    "HOOK_STATE",
    "OBJECTIVE",
    "REPO",
    "BRANCH",
    "WORKTREE",
    "STARTING_COMMIT",
    "DIRTY_FILES",
    "FILES_ALLOWED",
    "DIRECTORIES_ALLOWED",
    "FILES_OFF_LIMITS",
    "EXTERNAL_SYSTEMS_ALLOWED",
    "SENSITIVE_DATA_RISK",
    "CREDENTIAL_RISK",
    "PRODUCTION_WRITE_RISK",
    "HARDWARE_RISK",
    "AUTOMATION_RISK",
    "TASK_SPECIFIC_DOCS",
    "PLAN",
    "VALIDATION_COMMANDS",
    "EXPECTED_EVIDENCE",
    "APPROVAL_BEFORE_EDITS",
    "APPROVAL_BEFORE_EXTERNAL_WRITES",
    "APPROVAL_BEFORE_STAGING",
    "APPROVAL_BEFORE_COMMIT",
    "APPROVAL_BEFORE_PUSH",
    "FILES_CHANGED",
    "VALIDATION_RUN",
    "VALIDATION_NOT_RUN",
    "FOLLOW_UP_NEEDED"
  ],
  "patternProperties": {
    "^[A-Z0-9_]+$": {
      "type": "string",
      "minLength": 1
    }
  }
}
