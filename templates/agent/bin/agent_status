#!/usr/bin/env python3
"""Print bounded repo status for agent handoffs."""

from __future__ import annotations

import subprocess
import sys


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        capture_output=True,
        text=True,
        check=False,
    )


def main() -> int:
    inside = git("rev-parse", "--is-inside-work-tree")
    if inside.returncode != 0:
        print("Not inside a Git worktree.", file=sys.stderr)
        return inside.returncode

    branch = git("branch", "--show-current")
    if branch.returncode == 0:
        print(f"Branch: {branch.stdout.strip() or '(detached HEAD)'}")

    head = git("rev-parse", "--short", "HEAD")
    if head.returncode == 0:
        print(f"Head: {head.stdout.strip()}")

    print()
    print("## Git status")
    status = git("status", "--short", "--branch")
    if status.returncode != 0:
        print(status.stderr.strip() or status.stdout.strip() or "git status failed")
        return status.returncode
    print(status.stdout.strip() or "Clean worktree.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
